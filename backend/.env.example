# Spring Boot Profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# AI Service Configuration
AGROAI_AI_SERVICE_BASE_URL=http://localhost:8000
AGROAI_AI_SERVICE_KEY=
AGROAI_IRRIGATION_MOISTURE_THRESHOLD_PERCENT=
AGROAI_IRRIGATION_THRESHOLD_SOURCE=
AGROAI_IRRIGATION_THRESHOLD_VERSION=unconfigured

# Development image storage only; production requires an approved ImageStorage adapter.
AGROAI_LOCAL_IMAGE_DIR=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Firebase Configuration (Populate when Firebase project is established)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/path/outside/repo/service-account.json

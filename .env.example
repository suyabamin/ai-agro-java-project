# ============================================================
# AgroAI – Environment Variables Template
# Copy this file to .env and fill in all required values.
# NEVER commit a filled-in .env file to version control.
# ============================================================

# ── Firebase / Firestore ─────────────────────────────────────────
# Your Firebase project ID (not the web API key)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to the Firebase Admin SDK service-account JSON inside the container.
# Place the actual file at ./secrets/firebase-service-account.json
# (the docker-compose.yml mounts ./secrets → /secrets read-only)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json

# ── AI Service ───────────────────────────────────────────────────
# Shared secret used by the backend to authenticate requests to the AI service.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
AGROAI_AI_SERVICE_KEY=your-secret-key-here

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend API.
# Example: https://app.yourdomain.com,https://www.yourdomain.com
AGROAI_ALLOWED_ORIGINS=https://yourdomain.com

# ── Storage ──────────────────────────────────────────────────────
# Supported values: gcs | local | none
# Production: use 'gcs'.  Development: use 'local'.  Disabled: 'none' (returns 503)
AGROAI_STORAGE_PROVIDER=none

# Required only when AGROAI_STORAGE_PROVIDER=gcs
AGROAI_GCS_BUCKET_NAME=

# ── Irrigation Planner ───────────────────────────────────────────
# Soil-moisture percentage threshold for irrigation recommendation
AGROAI_IRRIGATION_MOISTURE_THRESHOLD_PERCENT=40

# Human-readable source identifier for audit trail
AGROAI_IRRIGATION_THRESHOLD_SOURCE=operator-manual

# Version tag for the threshold configuration
AGROAI_IRRIGATION_THRESHOLD_VERSION=1.0.0

# ── Frontend (Vite / React) ───────────────────────────────────────
# Firebase web configuration — obtain from Firebase Console → Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL seen by the browser
VITE_API_BASE_URL=http://localhost:8080/api/v1

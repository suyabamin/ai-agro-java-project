# ============================================================
# AgroAI – Frontend Environment Variables Template
# Copy to frontend/.env.local for local development.
# For production builds, inject at build time or via CI.
# ============================================================

# Firebase web configuration — obtain from Firebase Console → Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL (must NOT end with a slash)
# Development:  http://localhost:8080/api/v1
# Production:   https://api.yourdomain.com/api/v1  (or /api/v1 if served by nginx proxy)
VITE_API_BASE_URL=http://localhost:8080/api/v1
